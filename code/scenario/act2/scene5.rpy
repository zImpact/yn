    jump yn_act2_scene5_mz_second_dialogue_wh

label yn_act2_scene5_mz_sh_date:
    $ renpy.block_rollback()
    $ yn_act2_scene5_dialogue_threshold = 3 if yn_act2_scene5_get_us_apple else 2

    if yn_pigeons_group >= yn_act2_scene5_dialogue_threshold:
        $ yn_act2_scene5_mz_succes = True
        yn_narrator "Она не ответила, а только опустила голову задумавшись о чём-то."
        show mz shy glasses pioneer with dspr
        yn_narrator "А затем от смущения сказала вовсе не то, что хотела и что было совсем уж неуместно."
        yn_mz "Неужели всё то, о чём мне приходилось только читать в романах начало через ниши проникать и в мою жизнь?"
        yn_yana "Э-э-э... Наверное."
        yn_mz "А почему он не пришёл сам?"
        yn_th "Ну да... Идея, конечно, хорошая, но всё же стоило её для начала обдумать. И что мне теперь ей говорить?"
        yn_th "Ладно. Если уже начала врать, придётся идти до конца. Импровизируем."
        yn_yana "Ну... Он не знал как ты отреагируешь. Хотел... Прощупать почву, так сказать. Знаю, что глупо, но как получилось."
        yn_mz "А где и когда?"
        yn_th "Да ты издеваешься?"
        yn_yana "Он хотел узнать согласна ли ты вообще. Если да, то он сам придёт."
        yn_mz "Ладно... Скажи ему, что я согласна и буду сегодня его ждать."
        show mz smile glasses pioneer with dspr
        yn_narrator "Женя наконец подняла голову и взглянула на меня. В её взгляде появилось что-то такое, что я доселе не видела никогда. Новое чувство."
        yn_mz "И... Спасибо тебе, Яна."
        yn_yana "Всегда пожалуйста. Ладно. Пойду теперь к твоему Ромео."
        show mz shy glasses pioneer with dspr
        yn_th "Упс. Теперь я вогнала её в краску и она снова потупив взгляд опустила голову."
        stop ambience fadeout 2
        stop music fadeout 2
        scene bg ext_library_day with dissolve
        play ambience ambience_camp_center_day fadein 2
        yn_narrator "Я молча вышла из библиотеки."
        yn_th "Очень повезло, что мою уловку сейчас не раскрыли."
        yn_th "Теперь остаётся надеяться, что Электроник тоже испытывает к Жене тёплые чувства, иначе это будет ужасный провал."

    else:
        $ yn_pigeons_group -= 1
        show mz rage glasses pioneer with dspr
        yn_narrator "Она мельком глянула в мою сторону."
        yn_narrator "Глаза у неё были пустые, обращённые внутрь. Затем с выражением брезгливого сомнения она пугающе спокойным голосом сказала:"
        yn_mz "Я отвечу, что ты спуталась не с той компанией. Очень смешно."
        yn_mz "Услышали, что мы не безразличны друг другу и подослали тебя, чтобы поглумиться."
        yn_mz "Ведь действительно будет забавно посмотреть как дурочка из библиотеки побежит к парню, который понятия не имеет ни о какой такой прогулке."
        show mz normal glasses pioneer with dspr
        yn_mz "Яна, я хорошо к тебе отношусь и не хочу этого портить."
        yn_mz "Давай, я сделаю вид, что ты не пыталась по указке своих дружков так подло надо мной подшутить, а ты сейчас уйдёшь и больше никогда не будешь поднимать эту тему. Хорошо?"
        yn_narrator "Гадкое чувство."
        stop ambience fadeout 2
        stop music fadeout 2
        scene bg ext_library_day with dissolve
        play ambience ambience_camp_center_day fadein 2
        yn_narrator "Я кивнула и молча вышла вон."
        yn_th "Да уж. Это было действительно глупо. Похоже, я сильно обидела Женю. Не стоило даже пытаться идти на такие уловки."

    $ renpy.block_rollback()
    $ yn_act2_scene5_map.yn_map_call()

