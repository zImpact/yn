    $ yn_act2_scene5_map.yn_map_call()

label yn_act2_scene5_map_artclub:
    $ renpy.block_rollback()
    yn_th "Думаю, стоит попробовать узнать, что можно попробовать сделать с помощью Синиц."
    yn_th "Поищу-ка я Журналистку. Если кто-то и знает все подробности, то это - именно она."
    yn_th "Начну её поиски с художественного кружка, заодно проведаю Красавицу."
    stop music fadeout 2
    stop ambience fadeout 2
    scene bg yn_int_artclub_day
    show yn_kras normal at left
    show yn_wuk smile pos1 at right
    with fade
    play music yn_gerbarii_vselennaya fadein 5
    play ambience ambience_music_club_day fadein 2
    yn_narrator "К сожалению, Журналистки здесь нет. Но Красавица была на месте, а ещё тут оказался... Ёж."
    yn_narrator "Облокотившись на стол, за которым сидела Красавица, он сверлил её нахальным, можно даже сказать, хищным взглядом."
    yn_narrator "Парень задавал ей какие-то глупые и непристойные вопросы, а пионерка изредка отвечала и то односложно, и очень кратко."
    
    if #Эмпатия
        yn_narrator "В голосе её слышалось едва скрываемое раздражение, но «собеседника» это вовсе не волновало."

    yn_narrator "Красавица смотрела перед собой холодно и колюче, а на столе под её рукой лежал лист бумаги, на которой штрих за штрихом появлялся рисунок мёртвого иссохшего дерева."
    yn_th "Атмосфера, мягко говоря, неприятная."
    yn_yana "Красавица! Привет!"
    show yn_wuk surprised pos2 with dspr
    yn_narrator "Ёж от неожиданности дёрнулся и резко оглянулся через плечо. Он двигает бровью, прищуривая один глаз."
    yn_th "Знакомый взгляд. Оценивает. Надо же."
    show yn_kras smile with dspr
    yn_narrator "Красавица медленно подняла голову и с лёгкой улыбкой взглянула на меня."
    
    if #Эмпатия
        yn_narrator "Улыбка получилась вымученной."

    yn_narrator "Я ожидала увидеть в её глазах безмолвную просьбу о помощи, но ничего подобного там не было."
    yn_th "Такому стоицизму позавидует даже человек живущий карточной жизнью под «Берёзкой»."
    #Энциклопедия-сноска: "«Берёзка» — сеть фирменных розничных магазинов в СССР, реализовывавших дефицитные продукты и потребительские товары за иностранную валюту."
    yn_kras "Привет."
    yn_wuk "Надо же, а как зовут такую прелестную пионерку?"
    yn_th "Ничего себе, как он резво перестроился."
    
    if #Харизма
        yn_narrator "Интересно, ему память отшибло что ли? Настолько травмирующим был мой первый отказ?" 
    else:
        yn_narrator "Любопытно, что он меня не вспомнил. Мы уже встречались в автобусе."

    yn_yana "Для тебя - Ящерица."
    yn_wuk "А что это за странная перчатка? Новая мода такая? Впервые такую фирму вижу, но тебе прям идёт! Прям найс."
    yn_th "Ладно. То, что мне идёт отсутствие руки, это что-то новенькое. Такого я ещё не слышала."
    
    if #Драматизм
        yn_yana "О, глупый человек. Твоему взору не понять, что нет руки в железной оболочке. Я без руки, примногонеуважаемый товарищ!"
    else:
        yn_yana "Это протез. У меня нет руки."
    show yn_wuk surprised2 pos2 with dspr
    yn_narrator "Ёж слегка приоткрывает рот от удивления, глаза забегали. Он растерян и выбит из колеи."
    yn_wuk "Какой ужас! Что случилось?"
    yn_yana "Ну, знаешь, бывает такое, когда тебе очень сильно нравится какая-то вещь, например, пальто. А потом проходит время, и оно приедается."
    yn_yana "Некогда любимое, а теперь опостылившее. Тогда в один день ты просто вешаешь его в шкаф и уже больше никогда не надеваешь."
    yn_yana "А затем рано или поздно моль окончательно портит пальто и уже без каких-либо сожалений ты его выбрасываешь. Вот так же у меня с рукой. Разонравилась."
    yn_yana "Теперь с новомодной биоэлектрической «перчаткой» хожу, пока тоже не надоест."
    yn_narrator "Растерянность и замешательство достигли глобальных масштабов из-за чего это выглядит так, словно он зол."
    yn_wuk "Э-э..."
    if #Харизма
        yn_narrator "А теперь подбери челюсть с пола, а то уже всё слюной заляпал. И выйди за дверь. Мне нужно поговорить с Красавицей."
    else:
        yn_yana "Теперь, извини, но должна попросить тебя выйти. Мне нужно поговорить с Красавицей на едине."
    show yn_wuk sad pos1 with dspr
    $ renpy.pause(1, hard=True)
    hide yn_wuk with dissolve
    yn_narrator "Парень поднимает вверх указательный палец, но не находя, что сказать, молча выходит за дверь."
    yn_th "Уверена, что в другом случае, он бы сказал какую-то похабную остроту, но я застала его врасплох и ему пришлось капитулировать."
    yn_th "Явно ненадолго. Как только я уйду, он снова сюда вернётся."
    yn_th "Неужели Красавица действительно не может сказать «нет»?" 
    
    if #Восприятие
        yn_narrator "Мне же в первый день сказала, когда я про Лагерь распрашивала."

    yn_narrator "Убедившись, что он отошёл, я подошла к двери и закрыла её на замок."
    show yn_kras:
        linear 1.0 xalign 0.5
    $ renpy.pause(1, hard=True)
    yn_yana "Почему ты просто его не выгнала? Если не можешь этого сделать, давай, я попрошу кого-то из парней помочь с этим ходячим недоразумением?"
    yn_kras "Ох, не стоит беспокоится и тратить на меня время. Всё в порядке. Давай, пожалуйста, пока закроем эту тему. Ты что-то хотела?"
    yn_narrator "Рассеянная улыбка. Она благодарна за внимание и предложенную помощь, но почему-то отказывается от неё."

    if #Эмпатия
        yn_narrator "Мне очень не нравится фраза: «Не стоит беспокоится и тратить на меня время». Что-то подобное я слышала и от Хаера. У них много общего. Не понимаю."

    yn_th "Словно, навязчивость Ежа - всего лишь не стоящая времени мелочь, на которую она даже не обращает внимание, а её мысли занимает что-то более серьёзное. Но я-то слышала, как она неудачно пытается скрыть раздражение. Актриса из неё не самая лучшая."
    yn_yana "Ладно. Отложим этот вопрос. Пока что. Если ты не хочешь об этом говорить. Я ищу Журналистку. Не видела её?"
    yn_kras "Что-то случилось?"
    yn_yana "Нет. Мне сказали, что Шурик должен кому-то из вас. Вот, хотела узнать. Хотя, возможно, и ты знаешь?"
    yn_kras "Ну, с Журналисткой ты угадала. Шурик действительно должен предоставить практически любую услугу в рамках разумного, конечно, и должен он как раз Журналистке. Поищи её в музыкальном клубе. Она в это время скорее всего там, ибо упомянала вчера про работу над стенгазетой."
    yn_th "Даже не спрашивает зачем мне эта информация. Интересный у неё характер. Она точно сестра Кузнечика?"
    yn_yana "Спасибо! Ты меня выручила. Не знаешь, кстати, за что он должен?"
    yn_kras "Извини, не знаю."

    if #Восприятие
        yn_narrator "Отвела взгляд и почесала нос. Явно врёт. Любопытно, но давить на неё я ни в коем случае не стану."

    yn_yana "Ладно. Ещё раз спасибо. Могу я попросить тебя об одном маленьком одолжении?"
    yn_kras "Конечно."
    yn_yana "Когда я уйду, закрой за мной дверь на замок минут на десять, пожалуйста. Договорились?"
    yn_narrator "Красавица пожимает плечами, откладывает в сторону карандаш и встаёт из-за стола."
    yn_kras "Хорошо."
    yn_narrator "Ежа за дверью не оказалось, но я уверена, что он всё ещё где-то неподалёку."

    if #Драматизм
        yn_narrator "Он словно мерзкий зверь учуяв кровь, кружит на беззащитной жертвой, но мы не можем спокойно смотреть и ропщем."

    $ renpy.block_rollback()
    $ yn_act2_scene5_zones_dict["yn_music_club"] = "yn_act2_scene5_map_musclub"
    $ yn_act2_scene5_map.yn_map_call()

