            if #Восприятие
                yn_th "Да уж, не стоило пропускать слова Славяны мимо ушей. Как бы этот инцидент теперь не усложнил мне задачу."

        yn_mz "Просто не приноси их больше. Никогда. Вообще."

    $ yn_act2_scene5_mz_first_dialogue_variants_d = {
