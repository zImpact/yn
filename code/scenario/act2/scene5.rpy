        5: ["{b}Шурик, можем поговорить?{/b}", "yn_act2_scene5_sh_dialogue_flirt", False, 240]
    }

    if not yn_act2_scene5_jurn_succes and not yn_act2_scene5_mz_succes:
        $ yn_act2_scene5_sh_first_dialogue_variants_d[1] = ["Ладно. Было приятно повидаться.\nЯ пойду", "yn_act2_scene5_sh_dialogue_leave", False]

    if yn_act2_scene5_jurn_succes:
        $ yn_act2_scene5_sh_first_dialogue_variants_d[3] = ["{b}У меня записка от Журналистки.{/b}", "yn_act2_scene5_sh_dialogue_jurn", False, 100]

    if yn_act2_scene5_mz_succes:
        $ yn_act2_scene5_sh_first_dialogue_variants_d[4] = ["{b}Электроник, нужно поговорить.{/b}", "yn_act2_scene5_sh_dialogue_mz", False, 100]

    $ yn_act2_scene5_sh_second_dialogue_variants_d = {
        1: ["{b}А можно нам посмотреть\nпару фильмов на\nвидеомагнитофоне?{/b}", "yn_act2_scene5_sh_dialogue_ask", False],
        5: ["{b}Флирт.{/b}", "yn_act2_scene5_sh_dialogue_flirt_continue", False, 650]
