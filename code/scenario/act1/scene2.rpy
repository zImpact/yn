label yn_act1_scene2:
    $ yn_onload("lock")
    $ renpy.block_rollback()
    $ persistent.timeofday = "day"
    $ persistent.sprite_time = "day"
    $ persistent.yn_protagonist_mood = "sleepy"
    $ renpy.pause(3, hard=True)
    $ yn_chapter_intro(
        "Действие второе.",
        "bg yn_ext_square_lenin_day_blurred",
        "camp_center_day",
        "yn_yana smile2",
        "yn_play_two_intro_text"
    )
    scene bg black with Dissolve(2)
    $ renpy.pause(1, hard=True)
    $ yn_onload("unlock")
    $ yn_set_timeofday_cursor_var = True
    scene bg yn_int_house_of_yana_day_1 with Dissolve(2)
    play ambience ambience_int_cabin_day fadein 2
    play music music_list["everyday_theme"] fadein 4
    # TODO: здесь добавить уведомление о том, что появились новые записи в дневнике (Домик Яны в лагере)
    yn_narrator "Проснулась я от того, что уже одетая Виолетта слегка трясла меня за плечи. Яркие лучи утреннего солнца уже пробивались через занавески."
    show cs normal glasses at center with dissolve
    yn_cs "Вставай, дорогая, линейка на площади начнётся через двадцать минут. Рекомендую не опаздывать, Ольга этого ой как не любит."
    yn_yana "Сон борется с болезнями." 
    yn_cs "Вставай, кому говорю! Я и так позволила тебе проспать зарядку!" 
    yn_narrator "Преодолев столь манящие объятия постели, я встала и начала одеваться."
    yn_narrator "В соседке словно пробудился необъяснимый материнский инстинкт, когда она пригладила мне волосы и помогла правильно завязать пионерский галстук."
    yn_narrator "Такой обыденный, казалось бы процесс вызывает некоторые трудности, когда не можешь нормально управлять пальцами на эрзаце второй руки."
    hide cs with dissolve
    yn_narrator "Затем она попрощалась и ушла по делам." 
    yn_narrator "За окном дышало свежестью ласковое летнее утро, птицы пели понятные только им серенады, шуршал листьями заплутавший ветерок." 
    yn_th "После звонких гудков автомобилей и зноя городской жизни это место кажется настоящим Эдемским садом."
    stop ambience fadeout 2
    scene bg black with Dissolve(2)
    pause 0.5
    scene bg ext_washstand_day with Dissolve(2)
    play ambience ambience_camp_center_day fadein 2
    yn_narrator "Кое-как сориентировавшись, я нашла умывальники, возле которых приводили себя в порядок несколько пионеров."
    yn_narrator "Условия, конечно, спартанские."
    yn_narrator "Я отошла подальше от прочих пионеров, чтобы не смущать их видом культи."
    yn_narrator "Аккуратно сняла протез, столь же бережно положила его на траву подальше от умывальника."
    yn_narrator "Помио ухода за собой нужно ещё ежедневно ухаживать за протезом."
    yn_narrator "Протирать его мягкой тканью, смоченной в теплой воде, тщательно высушивать все компоненты, очищать электроды специальным раствором для обеспечения хорошего контакта с кожей."
    yn_narrator "Утренние процедуры теперь приобрели вид некторого ритуала."
    yn_narrator "Из плюсов: Нужно мыть на одну руку меньше."
    yn_narrator "Из минусов: Умываться приходится в несколько подходов."
    yn_narrator "Умывшись и почистив зубы, я уже собиралась на линейку, но вспомнив, что у меня с собой пакет умывальных принадлежностей, пришлось идти обратно к домикам и только потом спешить на построение." 
    scene bg ext_houses_day with dissolve
    yn_narrator "Пока шла вдоль жилого квартала мимо меня подобно вихрю промчалась орава пионерок и пионеров, чуть не сбив меня с ног."
    yn_narrator "Остановилась только одна девчушка лет пятнадцати - шестнадцати, с огненными волосами, заплетёнными в два забавных хвостика. Она поддержала меня за локоть, помогая не потерять равновесие."
    show yn_us grin at center with dspr
    yn_us_girl "Не зевай!"

    if yn_has_skill(YN_EMPATHY_SKILL):
        yn_narrator "Одного лишь взгляда на нё достаточно, чтобы понять, что эта непоседа из-за своей детской непосредственности далеко не всегда осознаёт последствия своих действий."

    hide yn_us with dspr
    yn_narrator "И не проронив больше ни слова умчалась вслед за остальными из её бешеной стаи."
    yn_th "Ну и нравы же у местных!"
    stop music fadeout 3
    scene bg yn_ext_square_lenin_day with dissolve
    $ persistent.yn_protagonist_mood = "sad"
    yn_narrator "На площади пионеры уже выстроились в длинные шеренги по росту. В стороне стояло несколько вожатых, вовремя грозя пальцем нарушающим тишину ребятам." 
    yn_narrator "Я встала к своему первому отряду и окинула взглядом присутствующих."
    scene bg yn_ext_lineup_mi with dissolve
    play music music_list["get_to_know_me_better"] fadein 4
    yn_narrator "Здесь была как знакомая мне лично Мику, так и высокая светловолосая пионерка, которую я видела вчера разнимающей спор."
    yn_narrator "Ещё рядом стояла рыжая торпеда, с которой мы пересеклись несколько минут назад. Остальные были мне совершенно незнакомы."
    
    if #Восприятие
        yn_narrator "Тем не менее, по их поведению и взглядам друг на друга можно понять, что все друг друга знают достаточно давно."

    yn_narrator "Откашлявшись, Ольга Дмитриевна вышла вперёд и начала бравую тираду."
    yn_mt "Дорогие ребята, сегодня начинается ваша новая пионерская жизнь! Поэтому, вы должны приложить все усилия, чтобы она была полна радостей и приятных моментов!"
    yn_mt "Пусть с частью более взрослых ребят мы уже знакомы не первую смену, а некоторые из них уже являются комсомольцами и комсомолками, но помните, что все мы здесь одна большая семья."
    yn_mt "И в этой семье у каждого есть свои обязанности, на вас возложена огромная ответственность - участвовать в общественной жизни, помогать младшим, учиться, учиться и ещё раз учиться!"
    yn_mt "Надеюсь, по окончании смены у вас останутся только самые лучшие воспоминания о нашем лагере. Воспоминания на всю жизнь!"          
    yn_narrator "Дальше пошёл рассказ о той самой общественной деятельности, спортивных соревнованиях, зарнице и прочих конкурсах. Затем поднимали флаг."
    scene bg yn_ext_square_lenin_day with dissolve
    yn_narrator "После линейки большинству пионеров были розданы обходные листы с указанием {i}что, где и когда{/i}, после чего прозвучал горн и все голодные рты устремились в столовую."
    #В следующей строке показать Ольгу, Жулю и Славю.
    yn_narrator "Площадь в мгновение ока опустела. Осталась лишь Ольга Дмитриевна, переговаривающаяся с вожатой младшего отряда, и блондинка, которая подошла ко мне."
    #Ольга и Жуля исчезают из кадра. Остаётся только Славя с эффектом приближения.
    show yn_sl normal at center with dissolve
    yn_sl_blonde "Привет! Чего стоишь, как неприкаянная? Не знаешь где столовая?"
    yn_yana "Привет. Нет... В смысле знаю. Просто задумалась. Меня, кстати Яна зовут, а тебя?" 
    yn_sl "Славяна. Приятно познакомиться. О чём задумалась, Яна?" 
    yn_yana "Да так. Какое-то всё здесь странное, как будто все друг друга уже сто лет знают."
    show yn_sl smile with dspr
    yn_narrator "Губы Славяны расплылись в доброй, обезоруживающей улыбке."
    yn_sl "Это только кажется. Нет, конечно, в нашем первом, втором и третьем отряде большинство ребят приезжали сюда ни один раз и уже получили в обязанности управление некоторыми кружками, но практически все ребята помладше здесь впервые."
    yn_yana "Теперь понятно. Спасибо за объяснение."

    if #Восприятие
        yn_narrator "Тем не менее, она будто бы что-то не договаривает."

    show yn_sl serious with dspr
    yn_narrator "Брови девушки немного сошлись к переносице, а в глазах блеснул огонёк подозрения."
    yn_sl "Надеюсь, тебя тут не достают? Ты только скажи, я вмиг на них управу найду!"
    $ persistent.yn_protagonist_mood = "smile"
    yn_th "При взгляде на её неправдоподобно выглядящее грозное лицо снова пришло воспоминание о вчерашнем инциденте и в слова Славяны охотно верилось."

    if #Эмпатия
        yn_narrator "Из неё вышел бы неплохой дипломат."

    yn_yana "Нет, всё в порядке. У тебя нет никаких поводов для беспокойства."
    show yn_sl smile with dspr
    yn_sl "Как тебе лагерь? Если ты ещё не успела осмотреть все окрестности, я могу провести тебе небольшую экскурсию."
    yn_yana "Это было бы очень кстати."
    yn_sl "Хорошо. После обеда покажу тебе лагерь. Кстати, я - помощница вожатой, если ты хочешь о чём-то узнать, можешь спросить у меня. Не стесняйся. Тебя что-то интересует?"
    yn_yana "Да, можешь рассказать о нашем отряде?"
    show yn_sl normal with dspr
    $ persistent.yn_protagonist_mood = "normal"
    yn_narrator "В раздумьях Славяна потеребила локоном своих волос, пытаясь подобрать нужные слова."
    yn_sl "Ну, смотри, всего нас девять человек, включая тебя. Мы первый старший отряд, практически всем по семнадцать лет, кроме Ульяны, это такая низенькая озорница с рыжими волосами." 
    yn_yana "Так вот как зовут это стихийное бедствие."
    yn_sl "Вы уже встречались?"
    yn_yana "Да так, столкнулись на досуге." 
    yn_sl "На чём я остановилась? Ах да, не верь Ульяне, если будет говорить, что она твоя ровесница. Ей только вот-вот шестнадцать исполнится."
    yn_sl "В этот раз она в первом отряде только из-за того, что приехала уже третий раз и хорошо общается с Алисой Двачевской, другой рыжеволосой пионеркой. Они с Улей не разлей вода. {w}Две беды по цене одной."
    yn_narrator "Алису я уже видела за столом «Шутников» в столовой. Вполне ожидаемо, что Славяна столь нелестно отзывается об этой парочке."
    yn_yana "Продолжай."
    yn_sl "Есть ещё одна парочка, только уже мальчики. Они у нас будущие светила советской науки. Саша и Сергей, но Обоих, но в целом все называют их по прозвищам - Шурик и Электроник, из-за их очень странной схожести с героями кинофильмов, моих любимых, кстати."
    yn_sl "Потом, Женя - библиотекарша, короткая стрижка и очки с толстым стеклом."
    yn_sl "Мику - японка с русскими корнями, её то ты уж точно ни с кем не спутаешь, заведует музыкальным клубом."
    yn_sl "И Лена, скромная зеленоглазая девочка, любящая уединение."
    yn_sl "Вроде бы обо всех рассказала. Хочешь узнать что-то ещё?"    
    yn_narrator "Во время своего монолога Славяна смотрела мне прямо в глаза, а когда закончила, её взгляд нет-нет, да соскальзывал вверх, на манящее своей просторностью ясное небо."
    yn_th "Что бы у неё ещё спросить?"
    call screen yn_dialogue_wheel_info with Dissolve(0.5)
    $ yn_leave_choice_name = "Забудь, перейдем к сути" if renpy.has_label("osd_start") else "Нет, спасибо"

    $ yn_act1_scene2_sl_dialogue_d = {
        1: [yn_leave_choice_name, "yn_act1_scene2_sl_dialogue_leave", False],
        3: ["Расскажи про японку", "yn_act1_scene2_sl_dialogue_about_mi", False, 510], #При взятой восприятии показывает, что репутация у Синиц увеличится
        4: ["Расскажи о себе", "yn_act1_scene2_sl_dialogue_about_sl", False, 460],
        5: ["Расскажи о библиотеке", "yn_act1_scene2_sl_dialogue_about_library", False, 370]   #При взятой восприятии показывает, что репутация у Голубей увеличится 
    }

label yn_act1_scene2_sl_dialogue_wh:
    $ renpy.block_rollback()
    $ yn_act1_scene2_sl_dialogue_wheel = YnDialogueWheel(yn_act1_scene2_sl_dialogue_d)
    $ yn_act1_scene2_sl_dialogue_wheel.yn_dw_call()

label yn_act1_scene2_sl_dialogue_about_library:
    $ renpy.block_rollback()
    $ yn_pigeons_group += 1
    yn_sl "Рассказывать особо нечего, если честно."
    yn_sl "Никто, кроме членов литературного кружка, туда практически не ходит. Книги все старые. Последняя партия была лет девять назад."
    yn_sl "Заведующая там Женя, моя соседка. Я тебе о ней рассказывала. Могу добавить только то, что она на самом деле добрая и отзывчивая, хоть и кажется на первый взгляд довольно злой."
    yn_sl "Обожает Маяковского и Лермонтова. А ещё у неё сильная аллергия на яблоки, так что даже не думай их ей приносить."

    $ yn_sl_play_two_dialogue_counter += 1
    $ yn_sl_play_two_dialogue_about_library = True

    if yn_sl_play_two_dialogue_counter == 3:
        jump yn_act1_scene2_after_sl_dialogue

    else:
        jump yn_act1_scene2_sl_dialogue_wh

label yn_act1_scene2_sl_dialogue_about_sl:
    $ renpy.block_rollback()
    yn_sl "Ох, неожиданная просьба. Ну, я комсомолка и помощница вожатой, поэтому, хоть мы и одного возраста, ребята причислили меня к старшим."
    yn_sl "Для них это нечто большее, чем просто возраст и статус. Так что я не жалуюсь."
    yn_sl "Ещё люблю вышивать, вязать, плавать и наблюдать за природой. Мне поэтому и нравится этот лагерь."
    yn_sl "Красивая природа, пляж и такой чистый воздух! Ой... Что-то я заболталась. Хочешь узнать что-то ещё?"

    $ yn_sl_play_two_dialogue_counter += 1
    $ yn_sl_play_two_dialogue_about_yourself = True

    if yn_sl_play_two_dialogue_counter == 3:
        jump yn_act1_scene2_after_sl_dialogue

    else:
        jump yn_act1_scene2_sl_dialogue_wh

label yn_act1_scene2_sl_dialogue_about_mi:
    $ renpy.block_rollback()
    $ yn_tomtits_group += 1
    yn_sl "Мику у нас заведуют музыкальным клубом. Милая девушка, правда немного наивная."
    yn_sl "Говорит, что умеет играть на всех музыкальных инструментах. Звучит фантастично, но я ей верю."
    yn_sl "Она очень любит группу Ласковый май. Из фильмов предпочитает любовные и комедийные. Напрочь не переносит запах алкоголя или табака."
    yn_sl "Была уже одна неприятная история с кое-какими ребятами, что курили за музыкальным клубом."

    $ yn_sl_play_two_dialogue_counter += 1
    $ yn_sl_play_two_dialogue_about_miku = True

    if yn_sl_play_two_dialogue_counter == 3:
        jump yn_act1_scene2_after_sl_dialogue

    else:
        jump yn_act1_scene2_sl_dialogue_wh

label yn_act1_scene2_sl_dialogue_leave:
    $ renpy.block_rollback()
    if yn_sl_play_two_dialogue_counter == 0:
        $ yn_morality -= 1

    if renpy.has_label("osd_start"):
        yn_sl "Хм. К сути? Ты о столовой? Пошли."

    else:
        yn_sl "Ладно."
        
    jump yn_act1_scene2_after_sl_dialogue

label yn_act1_scene2_after_sl_dialogue:
    $ renpy.block_rollback()
    yn_sl "Кстати, раз уж ты у нас новенькая, думаю, тебе пригодится карта."
    yn_narrator "Она достала из нагрудного кармана сложенный в несколько раз листок."
    yn_sl "Чтобы не было проблем с обходным. Около лагерных ворот, конечно, есть стенд с картой, но так намного удобнее. Ладно, теперь всё. Пошли на завтрак, а то уже опаздываем."
    yn_yana "Спасибо за карту, пойдём."
    stop ambience fadeout 2
    stop music fadeout 4
    scene bg black with Dissolve(2)
    $ renpy.pause(1, hard=True)
    scene bg int_dining_hall_people_day with Dissolve(2)
    play ambience ambience_dining_hall_full fadein 2
    play music yn_everyday_theme fadein 10
    yn_narrator "Столовая жила своей жизнью, отдельной от всего остального лагеря. «Группировки», как и в прошлый раз, сидели в определённых местах, каждая занятая своими делами."
    yn_narrator "Славяна сказала, что ей нужно поговорить с вожатыми и попрощалась, напомнив об экскурсии." 
    yn_narrator "На завтрак было несколько оладий со сгущёнкой и стакан то ли с чаем, то ли с компотом. Взяв поднос, я направилась к ближайшему свободному столику."
    yn_us_voice "Эй, Ящерица!" 
    yn_narrator "Голос принадлежал Ульяне за столом «Шутников»."
    yn_narrator "Всего там сидели две девушки и трое парней. Первой пионеркой была Ульяна, а во второй по описанию Славяны я узнала Алису - высокую рыжую девушку с задорными огоньками в глазах." 
    yn_narrator "Заметив, что мой взгляд устремлён на неё, Ульяна начала активно махать рукой." 
    yn_yana "Ты мне?" 
    yn_us_ulya "Да. Айда к нам!" 
    yn_narrator "Сказать, что данное приглашение меня поразило - ничего не сказать, но раз уж уже позвали, отказываться будет моветоном."
    yn_th "Да и почему она назвала меня ящерицей? Думаю, это будет первым вопросом за данным столом."
    yn_narrator "Увидев, что я направляюсь к ним, один из трёх парней, примерно того же возраста, что и Ульяна, с кучерявыми волосами, быстро метнулся к столу «Стиляг» и бесцеремонно утащил один из их стульев."
    yn_narrator "Те промолчали, и казалось, что совершенно не удивились подобной выходке. Стул он поставил рядом с собой, пару раз похлопав по нему ладонью, предлагая сесть."
    yn_narrator "Помня о нравах «Шутников», я садилась очень медленно и аккуратно, но к моему удивлению никто даже не думал отодвинуть стул, чтобы я упала."
    show yn_us surp1:
        xpos -240

    show dv smile pioneer2:
        xpos 160    

    show yn_haer pity:
        xpos 850

    show yn_kot normal:
        xpos 470

    show yn_slon normal:
        xpos 1200

    with dissolve
